{
  "app-id": "org.sniptext.SnipText",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "sniptext",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--device=dri",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "tesseract",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/UB-Mannheim/tesseract/archive/5.3.0.tar.gz",
          "sha256": "4edac39733ce93b5c97ae59b80b45035262eadc4288b131a3a42040dce01b3a"
        }
      ]
    },
    {
      "name": "python-deps",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --prefix=/app --no-deps pyttsx3==2.90 loguru==0.7.2 pillow==10.0.1 pynput==1.7.6 easyocr==1.7.1 symspellpy==6.7.9 scikit-learn==1.3.1 opencv-python==4.8.1.78"
      ]
    },
    {
      "name": "sniptext",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --prefix=/app --no-deps .",
        "install -D org.sniptext.SnipText.desktop /app/share/applications/org.sniptext.SnipText.desktop",
        "install -D org.sniptext.SnipText.svg /app/share/icons/hicolor/scalable/apps/org.sniptext.SnipText.svg",
        "install -D man/sniptext.1 /app/share/man/man1/sniptext.1"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/dkorbelainen/sniptext.git",
          "branch": "main"
        }
      ]
    }
  ]
}
